rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Store settings (Brand identity, logo, QRIS, store info, shift configuration)
    match /store_settings/{settingId} {
      allow get, list, write: if true;
    }

    // Products catalog & inventory stock
    match /products/{productId} {
      allow get, list, write: if true;
    }

    // Categories
    match /categories/{categoryId} {
      allow get, list, write: if true;
    }

    // Transactions
    match /transactions/{transactionId} {
      allow get, list, write: if true;
    }

    // Customer directory
    match /customers/{customerId} {
      allow get, list, write: if true;
    }

    // Supplier expenses (Belanja supplier)
    match /expenses/{expenseId} {
      allow get, list, write: if true;
    }

    // Discounts presets
    match /discounts/{discountId} {
      allow get, list, write: if true;
    }

    // Cashier shifts & handover logs (Sync shift antar kasir & perangkat)
    match /shifts/{shiftId} {
      allow get, list, write: if true;
    }

    // Cashiers team
    match /cashiers/{cashierId} {
      allow get, list, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
